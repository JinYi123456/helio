{
  "name": "@helio/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./scripts/sentry-preload.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./scripts/sentry-preload.mjs dist/index.js",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "latest",
    "@hono/node-server": "latest",
    "@mastra/core": "latest",
