    "@sentry/node": "latest",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "ai": "latest",
    "hono": "latest",
    "mongodb": "latest",
    "pg": "^8.16.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.15.5",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
