# ── Helio agent — model ──────────────────────────────────────────────
# provider: ollama (local, default) | google | openrouter | custom
HELIO_PROVIDER=ollama
HELIO_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Google AI Studio — free Gemma API key  ->  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# OpenRouter — free tier includes google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Any OpenAI-compatible endpoint (llama.cpp, LM Studio, vLLM, ...)
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Helio services ───────────────────────────────────────────────────
TABPFN_URL=http://127.0.0.1:8790
PORT=8787

# TabPFN model weights need a one-time free license acceptance:
# register at https://ux.priorlabs.ai, accept the license, copy the API key.
TABPFN_TOKEN=
# Serve precomputed windows instead of fitting live (tiny hosts, 512MB RAM)
# HELIO_PRECOMPUTE_ONLY=1

# ── Optional partner tech — Helio degrades gracefully without these ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SERPAPI_KEY=
MONGODB_URI=
MONGODB_DB=helio
SENTRY_DSN=

# Set to 1 when the agent should also serve the built web app
SERVE_WEB=1
